# Vendored ARIS skills are SHA-256 verified against src/aris/manifest.ts:
# the manifest hashes the exact committed bytes (LF). Force LF checkouts so
# Windows autocrlf never breaks integrity verification.
aris-skills/** text eol=lf

# Shell/mjs entrypoints must be LF or Linux exec fails (/bin/sh^M).
*.sh text eol=lf
*.mjs text eol=lf
