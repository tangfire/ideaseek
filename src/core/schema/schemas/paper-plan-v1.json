{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ideaseek.dev/schemas/paper-plan-v1.json",
  "title": "IdeaSeek PaperPlan (paper-plan-v1)",
  "description": "Structural contract for the paper-plan output (ARIS paper-plan skill via the platform adapter). The venue pin against the stored plan and REVIEW_UNAVAILABLE enforcement are context/platform rules in TS — the schema is a sound subset; parsePaperPlanOutput runs the TS validator first.",
  "type": "object",
  "required": [
    "paperType",
    "venue",
    "maxPages",
    "contribution",
    "claimsEvidence",
    "structure",
    "figurePlan",
    "citationPlan",
    "reviewerFeedback",
    "nextSteps"
  ],
  "properties": {
    "paperType": {
      "type": "string",
      "minLength": 1
    },
    "venue": {
      "enum": ["ICLR", "NeurIPS", "ICML", "CVPR", "ACL", "AAAI", "ACM", "IEEE_JOURNAL", "IEEE_CONF"]
    },
    "maxPages": {
      "type": "integer",
      "minimum": 1
    },
    "contribution": {
      "type": "string",
      "minLength": 1
    },
    "claimsEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "evidence", "status"],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "location"],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "location": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "status": {
            "enum": ["supported", "partial", "unadjudicated"]
          }
        }
      }
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section", "purpose", "keyPoints"],
        "properties": {
          "section": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "keyPoints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "figurePlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "caption", "supportsClaims"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "supportsClaims": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "citationPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["topic", "candidates"],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "reviewerFeedback": {
      "type": "object",
      "required": ["verdict", "notes"],
      "properties": {
        "verdict": {
          "enum": ["ACCEPT", "REVISE", "REVIEW_UNAVAILABLE"]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nextSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
