{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ideaseek.dev/schemas/idea-review-v1.json",
  "title": "IdeaSeek IdeaReview payload (idea-review-v1)",
  "description": "Structural contract for the ARIS auto-review-loop idea-review payload. The not-ready/most-almost verdicts requiring >=1 weakness is self-contained and expressed via if/then; envelope fields (target/scope/reviewer/inputs hashes) are added by the platform, not the model.",
  "type": "object",
  "required": ["score", "verdict", "weaknesses", "summary"],
  "properties": {
    "score": { "type": "number", "minimum": 1, "maximum": 10 },
    "verdict": { "enum": ["ready", "almost", "not ready"] },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "detail", "minimumFix"],
        "properties": {
          "severity": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 },
          "minimumFix": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verdict": { "enum": ["almost", "not ready"] } },
        "required": ["verdict"]
      },
      "then": { "properties": { "weaknesses": { "type": "array", "minItems": 1 } } }
    }
  ]
}
