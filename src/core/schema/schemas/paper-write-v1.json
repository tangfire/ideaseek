{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ideaseek.dev/schemas/paper-write-v1.json",
  "title": "IdeaSeek Manuscript (paper-write-v1)",
  "description": "Structural contract for the paper-write output. The venue pin against the stored plan is enforced in TS parseManuscriptOutput — the schema is a sound subset; the TS validator runs first.",
  "type": "object",
  "required": [
    "venue",
    "title",
    "abstract",
    "sections",
    "bibliography",
    "qualityPasses",
    "manualFixes",
    "reviewerFeedback"
  ],
  "properties": {
    "venue": {
      "enum": ["ICLR", "NeurIPS", "ICML", "CVPR", "ACL", "AAAI", "ACM", "IEEE_JOURNAL", "IEEE_CONF"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "abstract": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "heading", "latex", "sources"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "latex": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\\\\documentclass"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "bibliography": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "bibtex"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "bibtex": {
            "type": "string",
            "minLength": 1,
            "pattern": "@"
          }
        }
      }
    },
    "qualityPasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "manualFixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewerFeedback": {
      "type": "object",
      "required": ["verdict", "notes"],
      "properties": {
        "verdict": {
          "enum": ["ACCEPT", "REVISE", "REVIEW_UNAVAILABLE"]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
