{
  "name": "ideaseek",
  "version": "0.1.0",
  "description": "DSH-based multi-agent research workflow platform",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.9"
  },
  "bin": {
    "ideaseek": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm test:python",
    "test:watch": "vitest",
    "test:python": "node worker/python/run-tests.mjs",
    "release-check": "node scripts/release-check.mjs",
    "docs:site": "node scripts/docs-site.mjs build && node scripts/docs-site.mjs check",
    "shell:spike": "tsc -p tsconfig.build.json && node dist/cli/shell/spike-main.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "ajv": "8.20.0",
    "commander": "^15.1.0",
    "ink": "6.8.0",
    "react": "19.1.10",
    "tree-kill": "1.2.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "@types/react": "19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  }
}
